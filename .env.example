# Copy to .env and fill in your own key: https://cloud.maptiler.com/account/keys/
MAPTILER_API_KEY=

# Optional. Powers scripts/import_ipeds.py's pull of post-graduation earnings
# and debt from the College Scorecard API. Free key: https://api.data.gov/signup/
# Unset, the ingest falls back to the public DEMO_KEY, which is rate-limited
# but plenty for this 25-school sample.
COLLEGE_SCORECARD_API_KEY=
